# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.1

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/vector_store/chroma

# Crawling Configuration
START_URL=https://gnu.ac.kr
MAX_CRAWL_DEPTH=5
CRAWL_RATE_LIMIT=1.0
USER_AGENT=GNU-RAG-Bot/1.0
MAX_PAGES=10000

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# LLM Configuration
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
